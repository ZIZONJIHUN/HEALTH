# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers scratch directory (never commit)
.superpowers/

# 비밀값이 들어갈 수 있는 공유 기본값 파일도 무시한다 (스캐폴드가 덮어쓰며 사라졌던 규칙)
.env
